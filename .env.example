# Surcharge facultative de la configuration
PULID_CONFIG=config/default.yaml
PULID_MODELS_ROOT=/Volumes/SSD/Documents/PuLID_models

# Ces variables sont aussi configurées automatiquement par pulid_app.paths.
HF_HOME=/Volumes/SSD/Documents/PuLID_models/huggingface
HUGGINGFACE_HUB_CACHE=/Volumes/SSD/Documents/PuLID_models/huggingface/hub
TRANSFORMERS_CACHE=/Volumes/SSD/Documents/PuLID_models/huggingface/transformers
TORCH_HOME=/Volumes/SSD/Documents/PuLID_models/torch
XDG_CACHE_HOME=/Volumes/SSD/Documents/PuLID_models/other
MPLCONFIGDIR=/Volumes/SSD/Documents/PuLID_models/other/matplotlib
NO_ALBUMENTATIONS_UPDATE=1

