# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/

# Environnements et secrets
.venv/
.env
config/local.yaml

# Éditeurs et macOS
.DS_Store
._*
.idea/
.vscode/

# Modèles lourds : ils doivent rester sur le SSD externe
PuLID_models/
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.bin
*.gguf

# Artefacts locaux
outputs/*
!outputs/.gitkeep
cache/*
!cache/identity/
cache/identity/*
!cache/identity/.gitkeep
inputs/*
!inputs/.gitkeep
logs/

# Keep the locked Metal runtime in Git as well as in release archives.
# Other wheel build artifacts remain ignored.
runtime/wheels/*.whl
!runtime/wheels/llama_cpp_python-0.3.35-py3-none-macosx_11_0_arm64.whl
